<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SwapiMaui.Converters"
             x:Class="SwapiMaui.MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:GenderToImageConverter x:Key="GenderToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*"
          Margin="12 ,89,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Border Stroke="LightGray"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="White"
                    HeightRequest="40"
                    WidthRequest="351"
                    Margin="0,0,0,12">

                <Grid>
                    <Entry Placeholder="Search people"
                           Text="{Binding SearchText}"
                           PlaceholderColor="#8E95A4"
                           TextColor="Black"
                           BackgroundColor="Transparent"
                           FontSize="16"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="Center" />


                    <Image Source="search_icon.png"
                           Aspect="AspectFit"
                           HeightRequest="20"
                           WidthRequest="20"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="0,0,10,0" />
                </Grid>
            </Border>
        </Grid>

        <CollectionView ItemsSource="{Binding People}" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="LightGray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#FFFFFF"
                            WidthRequest="351"
                            HeightRequest="68"
                            Margin="0,0,0,12"
                            Padding="12,8">

                        <VerticalStackLayout Spacing="4">

                           
                            <HorizontalStackLayout VerticalOptions="Center" Spacing="8">
                                <Label Text="{Binding Name}"
                                       FontFamily="OpenSansSemiBold"
                                       FontSize="14"
                                       TextColor="#333333"
                                       VerticalOptions="Center" />

                                <Image Source="{Binding Gender, Converter={StaticResource GenderToImageConverter}}"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                           
                            <HorizontalStackLayout VerticalOptions="Center" Spacing="16">

                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Image Source="height_icon.png"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Height}"
                                           FontSize="14"
                                           TextColor="#5F6673"
                                           FontFamily="OpenSansSemiBold"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Image Source="weight_icon.png"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Mass}"
                                           FontSize="14"
                                           TextColor="#5F6673"
                                           FontFamily="OpenSansSemiBold"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>